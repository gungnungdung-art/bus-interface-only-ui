{
  "name": "ibms-driver-interface",
  "version": "1.0.0",
  "description": "IBMS 14inch bus driver interface (Electron + React, kiosk)",
  "license": "MIT",
  "author": "gnd",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "dist:win-x64": "npm run build && electron-builder --win --x64",
    "dist:win-arm64": "npm run build && electron-builder --win --arm64",
    "dist:linux-x64": "npm run build && electron-builder --linux --x64",
    "dist:linux-arm64": "npm run build && electron-builder --linux --arm64",
    "dist:all": "npm run build && electron-builder --win --x64 --arm64"
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "typescript": "^5.6.3",
    "vite": "6.3.5",
    "wait-on": "^8.0.1"
  }
}
